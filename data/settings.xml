<?xml version="1.1" ?>
<settings>
    <global>
        <auto_hide>true</auto_hide>
        <bad_ground_limit>7</bad_ground_limit>
        <blocked_progress>1</blocked_progress>
        <dig_interval>4</dig_interval>
        <dig_settle>2.5</dig_settle>
        <fatigue_cap>100</fatigue_cap>
        <finds_view>session</finds_view>
        <hud_visible>true</hud_visible>
        <jitter>0.6</jitter>
        <line_spacing>18</line_spacing>
        <max_success>100</max_success>
        <min_free_slots>2</min_free_slots>
        <move_timeout>8</move_timeout>
        <pos>
            <x>1100</x>
            <y>200</y>
        </pos>
        <require_mount>true</require_mount>
        <required_distance>5</required_distance>
        <result_timeout>5</result_timeout>
        <roam_radius>20</roam_radius>
        <stop_at_fatigue>true</stop_at_fatigue>
        <stop_echo>Kweh! This ground is all wark and no dig. Find me a better spot!</stop_echo>
        <stuck_check_time>1</stuck_check_time>
        <stuck_epsilon>0.2</stuck_epsilon>
        <turn_chance>50</turn_chance>
        <turn_distance>3</turn_distance>
        <warn_greens>10</warn_greens>
        <warn_slots>5</warn_slots>
        <zone_window>false</zone_window>
    </global>
    <valdimar>
        <pos>
            <x>77</x>
            <y>414</y>
        </pos>
        <zone_window>true</zone_window>
    </valdimar>
</settings>
